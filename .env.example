# ============================================================
# .env.example — Variáveis de Ambiente do Projeto Video Anchor
# The Anchor Records
# ============================================================
# Copie este arquivo para .env e preencha com seus valores:
#   cp .env.example .env
# NUNCA commite o arquivo .env no repositório!

# ── D-ID API (Lip-sync) ───────────────────────────────────
# Obtenha em: https://studio.d-id.com/account-settings
DID_API_KEY=seu_api_key_did_aqui

# ── OpenAI (TTS - Geração de Vozes) ──────────────────────
# Obtenha em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ── Google Drive (Exportação - Opcional) ──────────────────
# ID da pasta no Google Drive onde os vídeos serão enviados
# Encontre o ID na URL da pasta: drive.google.com/drive/folders/<FOLDER_ID>
GOOGLE_DRIVE_FOLDER_ID=

# ── Dropbox (Exportação - Opcional) ───────────────────────
# Gere um token em: https://www.dropbox.com/developers/apps
DROPBOX_ACCESS_TOKEN=
